{
  "manifest_version": 3,
  "name": "InputTest - Hardware & Input Device Tester",
  "short_name": "InputTest",
  "version": "1.0.0",
  "description": "Quickly test keyboard switches, mouse double-clicking, scroll wheel jump, CPS rate, gamepad drift, mic and webcam.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "InputTest - Hardware Tester",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": []
}
